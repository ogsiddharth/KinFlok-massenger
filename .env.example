# ==============================================================================
# KINFOLK PRIVATE FAMILY MESSENGER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables
# in the Netlify Dashboard (Site configuration > Environment variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (Server-Side / Netlify Functions)
# ------------------------------------------------------------------------------
# Required for the Kinfolk AI Help Assistant guide.
# Kept strictly server-side in Netlify Functions (never exposed to client browser).
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. FIREBASE CLOUD CONFIGURATION (Client-Side Real-Time Database & Storage)
# ------------------------------------------------------------------------------
# Optional for local test mode (the app features a full local persistence engine
# with multi-tab real-time sync for zero-friction testing).
# Provide these when connecting to your live Firebase project:
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
# Optional: Set if using a named Firestore database (default is "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
